# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DATABASE_URL=postgres://user:password@localhost:5432/translation_store

# Transifex API token (https://app.transifex.com/user/settings/api/)
TRANSIFEX_API_TOKEN=

# GitHub OAuth app for login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only Transifex activity at or after this instant earns points (ISO 8601, UTC)
LAUNCH_AT=2026-11-01T00:00:00Z

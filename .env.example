# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Leave empty for local SQLite. Production (Plan 2) uses Postgres.
DATABASE_URL=

# Transifex API token (https://app.transifex.com/user/settings/api/)
TRANSIFEX_API_TOKEN=

# Only Transifex activity at or after this instant earns points (ISO 8601, UTC)
LAUNCH_AT=2026-11-01T00:00:00Z

# GitHub OAuth App for translator login (github.com/settings/developers)
# Callback URL: http://localhost:8000/contas/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /cron/sync/ (any random 32+ chars)
CRON_SECRET=
# Extra hosts / origins besides the automatic *.vercel.app ones (e.g. a custom domain)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Gmail used to send store e-mails (needs 2-step verification + an App Password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: "Loja de Traduções WPILib <conta@gmail.com>"
DEFAULT_FROM_EMAIL=
# Base URL for links in e-mails (auto on Vercel)
SITE_URL=http://localhost:8000
